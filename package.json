{
  "name": "kit-exemplo-asfalto",
  "version": "1.0.0",
  "private": true,
  "description": "Exemplo: Pavimentação asfáltica completa com Kit Unificado",
  "scripts": {
    "dev": "remotion studio ../../src/index.tsx",
    "build": "remotion render ../../src/index.tsx main ../../output/video.mp4",
    "build:high": "node ../../tools/render.mjs exemplo-asfalto main ../../output/video.mp4 alta",
    "build:max": "node ../../tools/render.mjs exemplo-asfalto main ../../output/video.mp4 maxima",
    "thumb": "remotion render ../../src/index.tsx thumb ../../output/thumb.png",
    "thumb:yt": "node ../../tools/render.mjs exemplo-asfalto thumb ../../output/thumb_youtube.png",
    "thumb:tt": "node ../../tools/render.mjs exemplo-asfalto thumb_vertical ../../output/thumb_vertical.png",
    "validar": "node ../../tools/validar.mjs --projeto exemplo-asfalto",
    "audio:voz": "python ../../tools/voz.py \"$(cat roteiro.txt)\" assets/audio/narracao.wav --engine piper --voice fabio",
    "audio:palavras": "python ../../tools/palavras.py assets/audio/narracao.wav assets/audio/palavras.json --karaoke assets/audio/karaoke.json",
    "audio:sfx": "python ../../tools/sons.py engine assets/audio/sfx/engine.wav --duracao 5 --rpm 900 && python ../../tools/sons.py hydraulic assets/audio/sfx/hydraulic.wav --duracao 1.5 && python ../../tools/sons.py whoosh assets/audio/sfx/whoosh.wav --duracao 1 && python ../../tools/sons.py impact assets/audio/sfx/impact.wav --material pedra && python ../../tools/sons.py success assets/audio/sfx/success.wav",
    "audio:mix": "bash ../../tools/mix.sh assets/audio/narracao.wav assets/audio/sfx/ assets/audio/music.wav assets/audio/final.wav"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "4.0.542",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.542",
    "@remotion/cli": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "@types/react": "^18.2.0",
    "@types/three": "^0.160.0",
    "typescript": "^5.3.0"
  }
}
